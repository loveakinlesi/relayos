{
  "name": "relayos",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next-js": {
      "import": {
        "types": "./dist/next-js.d.ts",
        "default": "./dist/next-js.js"
      },
      "require": {
        "types": "./dist/next-js.d.cts",
        "default": "./dist/next-js.cjs"
      }
    },
    "./plugins/stripe": {
      "import": {
        "types": "./dist/plugins/stripe.d.ts",
        "default": "./dist/plugins/stripe.js"
      },
      "require": {
        "types": "./dist/plugins/stripe.d.cts",
        "default": "./dist/plugins/stripe.cjs"
      }
    },
    "./plugins/github": {
      "import": {
        "types": "./dist/plugins/github.d.ts",
        "default": "./dist/plugins/github.js"
      },
      "require": {
        "types": "./dist/plugins/github.d.cts",
        "default": "./dist/plugins/github.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}

{
  "name": "@restaq/core",
  "version": "0.1.5",
  "description": "The Restaq engine: durable executions, steps, retries, replay, and the contracts every Restaq package builds on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveakinlesi/restaq.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/loveakinlesi/restaq#readme",
  "bugs": "https://github.com/loveakinlesi/restaq/issues",
  "keywords": [
    "restaq",
    "webhooks",
    "events",
    "durable-execution",
    "typescript",
    "runtime",
    "retries",
    "replay"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "kysely": "^0.29.3"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.22.6",
    "pg": "^8.13.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}

{
  "name": "@relayos/cli",
  "version": "0.1.1",
  "description": "CLI for RelayOS - migrations and local dev tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveakinlesi/relayos.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/loveakinlesi/relayos#readme",
  "bugs": "https://github.com/loveakinlesi/relayos/issues",
  "keywords": [
    "relayos",
    "webhooks",
    "events",
    "durable-execution",
    "typescript",
    "cli",
    "migrations",
    "dev-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "relay": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@relayos/core": "workspace:^",
    "@relayos/stripe": "workspace:^",
    "@relayos/github": "workspace:^",
    "@relayos/clerk": "workspace:^",
    "@relayos/shopify": "workspace:^",
    "@relayos/resend": "workspace:^",
    "@clack/prompts": "^1.7.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}

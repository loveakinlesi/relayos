{
  "name": "@relayos/cli",
  "version": "0.0.1",
  "description": "CLI for RelayOS - migrations and local dev tooling.",
  "private": true,
  "type": "module",
  "bin": {
    "relay": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@relayos/postgres": "workspace:*",
    "relayos": "workspace:*",
    "drizzle-orm": "^0.43.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}

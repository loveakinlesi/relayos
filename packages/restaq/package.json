{
  "name": "restaq",
  "version": "0.1.1",
  "description": "The Restaq runtime: durable, replayable webhook and event execution for TypeScript backends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveakinlesi/restaq.git",
    "directory": "packages/restaq"
  },
  "homepage": "https://github.com/loveakinlesi/restaq#readme",
  "bugs": "https://github.com/loveakinlesi/restaq/issues",
  "keywords": [
    "restaq",
    "webhooks",
    "events",
    "durable-execution",
    "typescript",
    "sdk",
    "stripe",
    "github",
    "nextjs",
    "express",
    "hono",
    "nestjs"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next-js": {
      "import": {
        "types": "./dist/next-js.d.ts",
        "default": "./dist/next-js.js"
      },
      "require": {
        "types": "./dist/next-js.d.cts",
        "default": "./dist/next-js.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.js"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relay": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.bin.config.ts && chmod +x dist/bin.js",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@restaq/core": "workspace:^",
    "@restaq/cli": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}

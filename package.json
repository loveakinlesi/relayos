{
  "name": "relayos",
  "description": "A durable webhook execution platform for building reliable, replayable, and observable event-driven backends.",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\""
  },
  "devDependencies": {
    "@relayos/cli": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.9.15",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}

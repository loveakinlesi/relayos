{
  "name": "@relayos/monorepo",
  "description": "A durable webhook execution platform for building reliable, replayable, and observable event-driven backends.",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\"",
    "prepare": "husky",
    "release": "turbo build --filter='./packages/*' && semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@relayos/cli": "workspace:*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "semantic-release": "^24.2.3",
    "tsup": "^8.0.0",
    "turbo": "^2.9.15",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
